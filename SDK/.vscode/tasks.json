{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "all",
            "type": "shell",
            "windows": {
                "command": ".vscode/winmk.bat all"
            },
            "command": "make all -j`nproc`",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
        ,{
            "label": "clean",
            "type": "shell",
            "windows": {
                "command": ".vscode/winmk.bat clean"
            },
            "command": "make clean -j`nproc`",
            "problemMatcher": [],
            "group": "build"
        }
        ,        {
            "label": "rdx verify",
            "type": "shell",
            "windows": {
                "command": "cmd /c \"..\\tests\\host\\run_tests.bat && ..\\tools\\check_rdx_boundaries.bat\"",
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/c"]
                    }
                }
            },
            "command": "make -C ../tests/host && bash ../tools/check_rdx_boundaries.sh",
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
